# Appwrite — public (client) config
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=usha_db
NEXT_PUBLIC_APPWRITE_PRODUCTS_COLLECTION_ID=products
NEXT_PUBLIC_APPWRITE_ORDERS_COLLECTION_ID=orders
NEXT_PUBLIC_APPWRITE_CATEGORIES_COLLECTION_ID=categories
NEXT_PUBLIC_APPWRITE_BUCKET_ID=product_images

# Server-only — used by admin actions and seed script
APPWRITE_API_KEY=your_server_api_key

# Admin gate — comma separated list of admin user emails (full access)
NEXT_PUBLIC_ADMIN_EMAILS=admin@ushaelectricals.com

# Editor gate — comma separated list of editor user emails
# Editors can manage categories, product descriptions/images, and product visibility.
# They CANNOT see orders, revenue, or change prices/stock.
NEXT_PUBLIC_EDITOR_EMAILS=editor@ushaelectricals.com
